HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
# Public explorer bootstrap; pool identities are labeled third-party attribution.
EXPLORER_API=https://mempool.guide/api
# Prefer a dedicated, fork-aware node in production. RPC overrides the explorer.
# Never use your private mining node or expose RPC publicly.
RPC_URL=
RPC_USER=
RPC_PASSWORD=
POLL_SECONDS=30
RETAIN_BLOCKS=30000
# One SHA-256 token digest per provider. Keep raw tokens with the provider.
# TELEMETRY_KEYS_JSON={"operator-name":"64-character-sha256-hex"}
TELEMETRY_KEYS_JSON={}

# Public aggregate node observations from thebtc.network; no private node RPC.
NODE_OBSERVATIONS_ENABLED=true

# Private platform-fee pilot. Leave false for the public marketplace.
# Invoices collect only the seller's 2% fee after buyer-reported completion.
MARKET_FEES_ENABLED=false
MARKET_FEE_API_ORIGIN=
MARKET_FEE_CHECKOUT_ORIGIN=
MARKET_FEE_STORE_ID=
MARKET_FEE_API_KEY=
MARKET_FEE_WEBHOOK_SECRET=
# Local isolated evaluation only; public payment origins require HTTPS.
MARKET_FEE_ALLOW_LOOPBACK=false
MARKET_FEE_MIN_INVOICE_SATS=600
